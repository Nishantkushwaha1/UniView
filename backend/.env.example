# --- Server ---
PORT=5000
NODE_ENV=development
# Comma separated list of allowed frontend origins. Leave empty in development to allow all.
CLIENT_URL=http://localhost:5173

# --- Database ---
MONGO_URI=mongodb://127.0.0.1:27017/uniview

# --- Security ---
# Use a long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=koi-bhi-lamba-random-text-yahan-change-karo

# --- Password reset emails (optional) ---
# Without SMTP_* the reset link is printed in this server's console (and returned by the API outside production).
APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=UniView <no-reply@uniview.app>
