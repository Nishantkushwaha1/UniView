{
  "name": "uniview-backend",
  "version": "2.0.0",
  "description": "UniView API - Universal Document Workspace",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node ../database/seed/seed.js",
    "test": "node --test tests/api.test.js",
    "setup": "npm install && npm install --prefix ../frontend",
    "dev:all": "concurrently -n api,web -c cyan,magenta \"npm run dev\" \"npm run dev --prefix ../frontend\"",
    "dev:frontend": "npm run dev --prefix ../frontend",
    "build": "npm run build --prefix ../frontend",
    "db:up": "docker compose -f ../database/docker-compose.yml up -d",
    "db:tools": "docker compose -f ../database/docker-compose.yml --profile tools up -d",
    "db:down": "docker compose -f ../database/docker-compose.yml down"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "nodemailer": "^10.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}